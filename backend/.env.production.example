# Production variables for the API. Set them on the host (render.yaml lists them);
# never commit real values.

# PostgreSQL connection string. Neon: Dashboard > Connect > turn "Connection pooling"
# off and copy the direct URL (migrations take advisory locks, which a pooler breaks).
DATABASE_URL=postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Signs and encrypts the session cookie. Generate with `bin/rails secret`
# (Render generates one from render.yaml).
SECRET_KEY_BASE=replace_with_output_of_bin_rails_secret

# Run Solid Queue jobs inside Puma, so one web process is enough
SOLID_QUEUE_IN_PUMA=true

# The API's own host (Rails host authorization) and the frontend origin (CORS)
APP_HOST=your-api.onrender.com
FRONTEND_URL=https://your-frontend.vercel.app

# Optional: SMTP for notification emails (Gmail needs an app password)
# SMTP_ADDRESS=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Optional: logging
# RAILS_LOG_LEVEL=info
